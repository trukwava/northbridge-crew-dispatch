# No external credentials are needed. All data is fictional.
PORT=4173
DB_PATH=./data/crew-dispatch.sqlite
# All demo routes require an explicit synthetic dispatcher header.
# Never use these demonstration credentials for a real deployment.

# Optional single-organization protected preview (keep the default AUTH_MODE=demo locally).
# AUTH_MODE=preview
# PREVIEW_DISPATCHER_KEY=<unique random secret at least 32 characters>
# PREVIEW_CREW_KEYS_JSON={"A":"<unique secret at least 32 chars>","B":"<unique secret>"}
# Do not commit a populated .env. Preview expects private HTTPS port forwarding.
